# Copy to backend/.env to override defaults. Every value here is optional in development.

ENVIRONMENT=development

# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./alcsr.db
# PostgreSQL (postgres:// and postgresql:// are rewritten to the asyncpg driver automatically):
# DATABASE_URL=postgresql://alcsr:alcsr@localhost:5432/alcsr

# Required when ENVIRONMENT=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
